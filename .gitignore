# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Published single-story static sites (scripts/publish-site.mjs)
*-site.zip

# Editor / OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
.idea/
.vscode/*
!.vscode/extensions.json

# Windows "downloaded from the internet" zone metadata
*:Zone.Identifier
*.Zone.Identifier

# Local reference archive — the original research documents plus the internal
# planning/development records (PLAN, DEVLOG, BACKLOG, VR spike notes). Kept on
# disk for reference, deliberately not published: the durable content from them
# now lives in docs/VISION.md and docs/ENGINEERING-NOTES.md.
/References/

# Story content — whitelist: only the canonical demo stories are tracked. Any
# other story folder (test/preview/author uploads, e.g. tokwawan-tak-shun-mall)
# is ignored so it never gets pushed to the remote.
/public/stories/*
!/public/stories/index.json
!/public/stories/demo/
!/public/stories/splat-example/

# Local-only dev tooling. Registers whatever stories exist in dist/ into
# dist/stories/index.json so gitignored author scans are testable in
# `vite preview` without dirtying the tracked public/stories/index.json.
scripts/dev-register-local-stories.mjs

# Generated demo assets (rebuilt by scripts/gen-assets.mjs on predev/prebuild)
public/stories/demo/assets/narration.wav
public/stories/demo/assets/cube.gltf
public/stories/splat-example/assets/scene.splat

# Author-supplied 3D scans — keep large binaries out of git (drop them in locally)
*.ksplat
*.splat
*.ply
*.spz
*.glb
*.sog

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.*
!.env.example

# TypeScript incremental build cache
*.tsbuildinfo
